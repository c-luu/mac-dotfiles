{{- $profiles := get . "profiles" -}}
{{- if or (not (kindIs "map" $profiles)) (not $profiles) -}}
{{- fail "configure nonempty local data.profiles before initialization; see examples/profiles.toml" -}}
{{- end -}}
{{- $aliases := dict -}}{{- $roots := dict -}}
{{- range $id, $p := $profiles -}}
{{- if or (not (regexMatch "^[a-z][a-z0-9-]*$" $id)) (eq $id "mac-dotfiles") -}}{{ fail "invalid or reserved profile ID" }}{{- end -}}
{{- if not (kindIs "map" $p) -}}{{ fail (printf "profile %s must be a table" $id) }}{{- end -}}
{{- range $field := list "authorName" "authorEmail" "sshAlias" "hostname" "sshUser" "identityFile" "expectedAccount" -}}
{{- $v := get $p $field -}}
{{- if or (not (kindIs "string" $v)) (not (trim $v)) (regexMatch "[[:cntrl:]]" $v) (regexMatch "(?i)(REPLACE_ME|CHANGEME|<[^>]*>)" $v) -}}{{ fail (printf "profile %s requires a valid %s" $id $field) }}{{- end -}}
{{- end -}}
{{- range $field := list "sshAlias" "hostname" "sshUser" "expectedAccount" -}}
{{- if not (regexMatch "^[A-Za-z0-9][A-Za-z0-9._-]*$" (get $p $field)) -}}{{ fail (printf "profile %s has invalid %s" $id $field) }}{{- end -}}
{{- end -}}
{{- $alias := lower $p.sshAlias -}}
{{- if hasKey $aliases $alias -}}{{ fail "duplicate SSH alias" }}{{- end -}}
{{- $_ := set $aliases $alias $id -}}
{{- $port := printf "%v" (get $p "port") -}}
{{- if or (not (regexMatch "^[0-9]+$" $port)) (lt (atoi $port) 1) (gt (atoi $port) 65535) -}}{{ fail (printf "profile %s requires a port from 1 to 65535" $id) }}{{- end -}}
{{- if regexMatch "[\\*?\\[\\]%]" $p.identityFile -}}{{ fail "identity file must be a literal path" }}{{- end -}}
{{- $_ := includeTemplate ".chezmoitemplates/normalize-path" (dict "path" $p.identityFile "home" $.chezmoi.homeDir) -}}
{{- if or (not (kindIs "slice" (get $p "repositoryRoots"))) (not $p.repositoryRoots) -}}{{ fail "profile requires repositoryRoots" }}{{- end -}}
{{- range $root := $p.repositoryRoots -}}
{{- if or (not (kindIs "string" $root)) (regexMatch "[[:cntrl:]\\*?\\[\\]]" $root) -}}{{ fail "repository root must be a literal path" }}{{- end -}}
{{- $normal := includeTemplate ".chezmoitemplates/normalize-path" (dict "path" $root "home" $.chezmoi.homeDir) -}}
{{- if eq $normal "/" -}}{{ fail "repository root cannot be /" }}{{- end -}}
{{- $normal = printf "%s/" (trimSuffix "/" (lower $normal)) -}}
{{- range $other, $owner := $roots -}}
{{- if and (ne $owner $id) (or (hasPrefix $other $normal) (hasPrefix $normal $other)) -}}{{ fail "overlapping repository roots across profiles" }}{{- end -}}
{{- end -}}
{{- $_ := set $roots $normal $id -}}
{{- end -}}
{{- end -}}
